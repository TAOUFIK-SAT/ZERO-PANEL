        const CATEGORIES = [
            { id: "all", name: "الكل" },
            { id: "Panels", name: "البانلات (Panels)" },
            { id: "Multiboot", name: "المولتي بوت (Multiboot)" },
            { id: "Channels", name: "ملفات القنوات" },
            { id: "Softcams", name: "الشفرات (Softcams)" },
            { id: "Media", name: "الميديا والـ IPTV" },
            { id: "Skins", name: "السكينات (Skins FHD)" },
            { id: "Plugins", name: "البلجنات العامة" },
            { id: "Picons", name: "البيكونات (Picons)" },
            { id: "Tools", name: "الأدوات والصور" }
        ];

        function initApp() {
            renderCategoryTabs();
            renderStoreCards(PLUGINS_DATABASE);
            renderClassicAccordion();
        }

        function renderCategoryTabs() {
            const container = document.getElementById("catFilters");
            container.innerHTML = CATEGORIES.map(c => `
                <button onclick="setCategory('${c.id}')" id="catBtn_${c.id}" 
                        class="px-3 py-1.5 rounded-lg font-bold transition ${c.id === 'all' ? 'bg-[#00e5ff] text-black shadow-md' : 'bg-[#182133] hover:bg-[#202c45] text-gray-300 border border-gray-700/50'}">
                    ${c.name}
                </button>
            `).join('');
        }

        function setCategory(catId) {
            activeCategory = catId;
            CATEGORIES.forEach(c => {
                const btn = document.getElementById(`catBtn_${c.id}`);
                if (c.id === catId) {
                    btn.className = "px-3 py-1.5 rounded-lg font-bold transition bg-[#00e5ff] text-black shadow-md";
                } else {
                    btn.className = "px-3 py-1.5 rounded-lg font-bold transition bg-[#182133] hover:bg-[#202c45] text-gray-300 border border-gray-700/50";
                }
            });
            filterPlugins();
        }

        function filterPlugins() {
            const term = document.getElementById("searchInput").value.trim().toLowerCase();
            let filtered = PLUGINS_DATABASE;

            if (activeCategory !== "all") {
                filtered = filtered.filter(item => item.cat === activeCategory);
            }

            if (term !== "") {
                filtered = filtered.filter(item => item.name.toLowerCase().includes(term) || item.cat.toLowerCase().includes(term));
            }

            renderStoreCards(filtered);
        }

        function renderStoreCards(items) {
            const container = document.getElementById("viewStore");
            document.getElementById("pkgCount").innerText = `تم العثور على ${items.length} حزمة في TAOUFIK STORE`;

            if (items.length === 0) {
                container.innerHTML = `<div class="col-span-full py-12 text-center text-gray-500 text-sm">لا توجد نتائج تطابق بحثك...</div>`;
                return;
            }

            container.innerHTML = items.map(pkg => `
                <div class="card-bg rounded-2xl p-4 hover:border-cyan-500/50 transition flex flex-col justify-between">
                    <div>
                        <div class="h-28 bg-[#0b0f19] rounded-xl flex items-center justify-center text-cyan-400 text-3xl mb-3 border border-gray-800">
                            <i class="fa-solid ${pkg.icon}"></i>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-[10px] bg-gray-800 text-cyan-300 px-2 py-0.5 rounded border border-gray-700 font-mono">${pkg.cat}</span>
                            <span class="text-[10px] text-emerald-400 font-mono">Official</span>
                        </div>
                        <h3 class="font-bold text-white text-sm mt-2 truncate">${pkg.name}</h3>
                    </div>
                    <div class="mt-4 pt-2.5 border-t border-gray-800 flex justify-between items-center text-xs">
                        <span class="text-gray-400 font-mono text-[11px]">Ready</span>
                        <button onclick="openTerminalModal('${pkg.name}', \`${pkg.cmd}\`)" class="bg-[#00e5ff] hover:bg-cyan-400 text-black px-4 py-1.5 rounded-lg font-bold flex items-center gap-1.5 transition">
                            <i class="fa-solid fa-cloud-arrow-down text-xs"></i> تثبيت
                        </button>
                    </div>
                </div>
            `).join('');
        }

        function renderClassicAccordion() {
            const container = document.getElementById("classicAccordion");
            const cats = [...new Set(PLUGINS_DATABASE.map(i => i.cat))];

            container.innerHTML = cats.map(cat => {
                const count = PLUGINS_DATABASE.filter(i => i.cat === cat).length;
                return `
                    <div class="inner-box rounded-xl p-3 cursor-pointer hover:bg-gray-800/60 transition flex justify-between items-center" 
                         onclick="setCategory('${cat}'); switchView('store');">
                        <div class="flex items-center gap-2">
                            <i class="fa-solid fa-folder text-amber-400"></i>
                            <span class="font-bold text-gray-200">قسم ${cat}</span>
                        </div>
                        <span class="text-gray-400 bg-gray-900 px-2.5 py-0.5 rounded-md border border-gray-800">${count} إضافة &gt;</span>
                    </div>
                `;
            }).join('');
        }

        function openTerminalModal(name, cmd) {
            currentPkgName = name;
            currentCmd = cmd;
            document.getElementById("modalTitle").innerHTML = `<i class="fa-solid fa-terminal text-[#00e5ff]"></i> <span>تثبيت: ${name}</span>`;
            document.getElementById("terminalCmdText").innerText = cmd;
            document.getElementById("terminalStatus").innerText = "جاهز للإرسال إلى الرسيفر...";
            document.getElementById("terminalModal").classList.remove("hidden");
        }

        function closeModal() {
            document.getElementById("terminalModal").classList.add("hidden");
        }

        function copyModalCmd() {
            navigator.clipboard.writeText(currentCmd);
            alert("تم نسخ أمر التثبيت بنجاح!");
        }

        function executeDirectly() {
            document.getElementById("terminalStatus").innerHTML = `<span class="text-amber-400 animate-pulse">جاري إرسال الأمر وتثبيت [${currentPkgName}] على الرسيفر...</span>`;
            setTimeout(() => {
                document.getElementById("terminalStatus").innerHTML = `<span class="text-emerald-400 font-bold">[SUCCESS] تم إرسال أمر التثبيت بنجاح إلى الرسيفر (${receiverIP})!</span>`;
            }, 1000);
        }

        function copyTelnet() {
            let cmd = `wget -q "--no-check-certificate" https://raw.githubusercontent.com/TAOUFIK-SAT/taoufik-store/main/installer.sh -O - | /bin/sh`;
            navigator.clipboard.writeText(cmd);
            alert("تم نسخ أمر التلنت إلى الحافظة:\n" + cmd);
        }

        function downloadZip() {
            alert("جاري تجهيز وتحميل ملف TAOUFIK-STORE.zip...");
        }

        function switchView(type) {
            const tabStore = document.getElementById("tabStore");
            const tabClassic = document.getElementById("tabClassic");
            const viewStore = document.getElementById("viewStore").parentElement;
            const viewClassic = document.getElementById("viewClassic");

            if (type === 'store') {
                tabStore.className = "bg-[#00e5ff] text-black font-extrabold px-5 py-2 rounded-xl text-xs flex items-center gap-2 shadow-lg shadow-cyan-500/10";
                tabClassic.className = "bg-[#182133] hover:bg-[#202c45] text-gray-300 font-bold px-4 py-2 rounded-xl text-xs flex items-center gap-2 border border-gray-700/50";
                viewStore.classList.remove("hidden");
                viewClassic.classList.add("hidden");
            } else {
                tabClassic.className = "bg-[#00e5ff] text-black font-extrabold px-5 py-2 rounded-xl text-xs flex items-center gap-2 shadow-lg shadow-cyan-500/10";
                tabStore.className = "bg-[#182133] hover:bg-[#202c45] text-gray-300 font-bold px-4 py-2 rounded-xl text-xs flex items-center gap-2 border border-gray-700/50";
                viewClassic.classList.remove("hidden");
                viewStore.classList.add("hidden");
            }
        }

        function changeIP() {
            let newIP = prompt("أدخل عنوان IP الخاص برسيفر الإنيجما 2:", receiverIP);
            if (newIP && newIP.trim() !== "") {
                receiverIP = newIP.trim();
                document.getElementById("badgeIP").innerText = receiverIP;
            }
        }

        function checkConnection() {
            alert(`تم فحص الاتصال بالرسيفر (${receiverIP}) - متصل بنجاح.`);
        }

        function restartGUI() {
            if (confirm("هل تريد إعادة تشغيل واجهة الجهاز (Restart GUI) الآن؟")) {
                fetch(`http://${receiverIP}/api/powerstate?newstate=3`);
                alert("تم إرسال أمر إعادة تشغيل الـ GUI للرسيفر!");
            }
        }

        initApp();
    </script>
